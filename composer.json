{
  "name": "luckyturn/craft-block-board",
  "description": "Visual matrix block picker",
  "type": "craft-plugin",
  "keywords": ["matrix", "editors"],
  "license": "MIT",
  "authors": [
    {
      "name": "LuckyTurn Media",
      "homepage": "https://luckyturnmedia.co.uk"
    },
    {
      "name": "Paul Stone",
      "homepage": "https://github.com/paulstone"
    }
  ],
  "support": {
    "email": "paul.stone@luckyturnmedia.co.uk",
    "issues": "https://github.com/LuckyTurnMedia/craft-block-board/issues?state=open",
    "source": "https://github.com/LuckyTurnMedia/craft-block-board",
    "docs": "https://github.com/LuckyTurnMedia/craft-block-board/blob/master/README.md"
  },
  "require": {
    "php": ">=8.2",
    "craftcms/cms": "^5.9.0"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "luckyturn\\craftblockboard\\": "src/"
    }
  },
  "extra": {
    "handle": "_block-board",
    "name": "Block Board",
    "developer": "LuckyTurn",
    "documentationUrl": "https://github.com/LuckyTurnMedia/craft-block-board/blob/develop/README.md",
    "class": "luckyturn\\craftblockboard\\BlockBoard"
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}